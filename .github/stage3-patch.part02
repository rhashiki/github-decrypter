+    status,
+    headers: { ...cors, "Content-Type": "application/json", "Cache-Control": "no-store" }
+  });
+}
+function html(body: string, status = 200) {
+  return new Response(body, {
+    status,
+    headers: { ...cors, "Content-Type": "text/html; charset=utf-8", "Cache-Control": "no-store" }
+  });

{
  "manifest_version": 3,
  "name": "Lovable Decrypter",
  "version": "2.2.1",
  "description": "AI engineering layer for Lovable projects with signed licenses, GitHub App authorization, Supabase OAuth and Gemini Free/User-Paid modes.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://lovable.dev/*",
    "https://*.lovable.dev/*",
    "https://api.github.com/*",
    "https://codeload.github.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.supabase.com/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background/service-worker-entry.js",
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lovable-decrypter@rhashiki.dev",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "websiteContent"
        ]
      }
    }
  },
  "action": {
    "default_title": "Lovable Decrypter v2.4 Build 3 · Editor Direto"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lovable.dev/*",
        "https://*.lovable.dev/*"
      ],
      "js": [
        "content/credential-ui-guard.js",
        "content/lovable-project-runtime.js",
        "content/content.js",
        "ui/ui.js",
        "ui/control-center.js",
        "ui/project-context.js",
        "ui/github-autosync.js",
        "ui/project-migration.js",
        "content/lovable-sync-verifier.js",
        "content/composer-bridge-v3.js"
      ],
      "css": [
        "ui/matrix.css",
        "ui/control-center.css",
        "ui/composer-bridge.css",
        "ui/editor-direct-v3.css",
        "ui/github-app.css",
        "ui/project-context.css",
        "ui/project-migration.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/fab.png",
        "assets/icon128.png"
      ],
      "matches": [
        "https://lovable.dev/*",
        "https://*.lovable.dev/*"
      ]
    }
  ]
}

{
  "manifest_version": 3,
  "name": "Lovable Decrypter",
  "version": "2.6.83",
  "version_name": "2.6 Build 83 · Functional Reattachment Phase 1",
  "description": "Canonical v11 launcher with explicit-user-action-only lazy reattachment of Tool Runtime, Context Engine v2 and Scope Intelligence v2. No legacy UI, polling, observers or automatic engine activation.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://lovable.dev/*",
    "https://*.lovable.dev/*"
  ],
  "background": {
    "service_worker": "background/canonical-runtime-entry.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://lovable.dev/*", "https://*.lovable.dev/*"],
      "js": ["launcher/launcher-runtime.js", "launcher/canonical-runtime-client.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "lovable-decrypter@rhashiki.dev",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "action": {
    "default_title": "Lovable Decrypter v2.6.83 · Functional Reattachment"
  }
}

{
  "manifest_version": 3,
  "name": "Lovable Decrypter",
  "version": "2.4.23",
  "version_name": "2.4 Build 23",
  "description": "AI engineering layer for Lovable projects with server-authoritative trust, commercial entitlements, Decrypter Intelligence, Knowledge, Model Gateway and pooled Decrypter Local GPU support.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": ["storage", "tabs", "downloads", "unlimitedStorage", "alarms"],
  "host_permissions": [
    "https://lovable.dev/*",
    "https://*.lovable.dev/*",
    "https://api.github.com/*",
    "https://codeload.github.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.supabase.com/*",
    "https://*.supabase.co/*"
  ],
  "background": { "service_worker": "background/service-worker-entry.js", "type": "module" },
  "browser_specific_settings": {
    "gecko": {
      "id": "lovable-decrypter@rhashiki.dev",
      "strict_min_version": "121.0",
      "data_collection_permissions": { "required": ["authenticationInfo", "websiteContent"] }
    }
  },
  "action": { "default_title": "Lovable Decrypter v2.4 Build 23 · Mass Scale" },
  "content_scripts": [
    {
      "matches": ["https://lovable.dev/*", "https://*.lovable.dev/*"],
      "js": [
        "content/ui-shell-bootstrap.js",
        "content/content.js",
        "content/ui-mount-guardian.js",
        "ui/ui.js",
        "content/credential-ui-guard.js",
        "content/lovable-project-runtime.js",
        "content/lovable-project-creator.js",
        "content/cloud-migrator-runtime-v2.js",
        "content/project-intelligence.js",
        "content/skill-router.js",
        "content/project-rules-cache.js",
        "ui/skills-engine.js",
        "ui/control-center.js",
        "content/checkpoint-ui.js",
        "content/batch-mode.js",
        "content/queue-project-context.js",
        "content/queue-atomic-skip.js",
        "content/queue-executor.js",
        "ui/project-context.js",
        "ui/github-autosync.js",
        "ui/project-migration.js",
        "ui/project-creator.js",
        "ui/supabase-project-manager.js",
        "ui/cloud-migrator-complete.js",
        "content/lovable-sync-verifier.js",
        "content/composer-bridge-v3.js",
        "content/composer-guardian.js",
        "content/build11-reconciliation.js",
        "ui/unified-launcher.js",
        "content/commercial-runtime.js",
        "content/build12-reconciliation.js",
        "content/live-operations.js",
        "content/activity-cloud-sync.js",
        "ui/activity-center.js",
        "content/build13-reconciliation.js",
        "ui/update-recovery.js",
        "content/build14-reconciliation.js",
        "content/build15-reconciliation.js",
        "content/build16-reconciliation.js",
        "content/build17-reconciliation.js",
        "content/build18-reconciliation.js"
      ],
      "css": [
        "ui/matrix.css",
        "ui/control-center.css",
        "ui/composer-bridge.css",
        "ui/composer-guardian.css",
        "ui/editor-direct-v3.css",
        "ui/github-app.css",
        "ui/project-context.css",
        "ui/project-migration.css",
        "ui/project-creator.css",
        "ui/supabase-project-manager.css",
        "ui/cloud-migrator-core.css",
        "ui/skills-engine.css",
        "ui/unified-launcher.css",
        "ui/unified-launcher-status.css",
        "ui/activity-center.css",
        "ui/update-recovery.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    { "resources": ["assets/fab.png", "assets/icon128.png"], "matches": ["https://lovable.dev/*", "https://*.lovable.dev/*"] }
  ]
}

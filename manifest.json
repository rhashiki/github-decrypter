{
  "manifest_version": 3,
  "name": "Lovable Decrypter",
  "version": "2.6.82",
  "version_name": "2.6 Build 82 · Canonical Launcher / Legacy UI Purge",
  "description": "Canonical v11 launcher as the single visual authority. Legacy UI, diagnostic shells, fallback mounts, polling, observers, background execution and provider runtimes remain absent from the shipped surface.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "host_permissions": [
    "https://lovable.dev/*",
    "https://*.lovable.dev/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://lovable.dev/*", "https://*.lovable.dev/*"],
      "js": ["launcher/launcher-runtime.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "lovable-decrypter@rhashiki.dev",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "action": {
    "default_title": "Lovable Decrypter v2.6.82 · Canonical Launcher"
  }
}

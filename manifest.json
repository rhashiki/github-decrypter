{
  "manifest_version": 3,
  "name": "Lovable Decrypter",
  "version": "2.6.84",
  "version_name": "2.6 Build 84 · Trust + Core Integrations",
  "description": "Stable Build 84 clean runtime with event-driven license/trust, GitHub App, Supabase OAuth, resource selection and on-demand Lovable project snapshot. No legacy UI stack, mount guardians, global observers, content polling or heavy runtime activation at boot.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://lovable.dev/*",
    "https://*.lovable.dev/*",
    "https://kkzxxnfxgrouhkzyszxs.supabase.co/*"
  ],
  "background": {
    "service_worker": "background/runtime-entry-v84-integrations.js"
  },
  "content_scripts": [
    {
      "matches": ["https://lovable.dev/*", "https://*.lovable.dev/*"],
      "js": [
        "launcher/launcher-runtime.js",
        "launcher/runtime-client-v84.js",
        "launcher/account-controller-v84.js",
        "launcher/ux-polish-v84.js",
        "launcher/integration-resource-manager-v84.js",
        "launcher/integration-resource-entrypoints-v84.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "lovable-decrypter@rhashiki.dev",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "websiteContent"]
      }
    }
  },
  "action": {
    "default_title": "Lovable Decrypter v2.6.84 · Trust + Core Integrations"
  }
}

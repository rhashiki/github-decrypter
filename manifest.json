{
  "manifest_version": 3,
  "name": "Lovable Decrypter",
  "version": "2.6.81",
  "version_name": "2.6 Build 81 · Diagnostic UI Shell",
  "description": "Diagnostic UI-shell restoration: real Decrypter FAB, panel and local navigation only. No background worker, storage, network, polling, observers, Composer, AI or backend execution.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "host_permissions": [
    "https://lovable.dev/*",
    "https://*.lovable.dev/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://lovable.dev/*", "https://*.lovable.dev/*"],
      "js": ["diagnostic/ui-shell-runtime.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/fab.png"],
      "matches": ["https://lovable.dev/*", "https://*.lovable.dev/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "lovable-decrypter@rhashiki.dev",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "action": {
    "default_title": "Lovable Decrypter v2.6.81 · Diagnostic UI Shell"
  }
}

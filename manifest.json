{
  "manifest_version": 3,
  "name": "Lovable Decrypter",
  "version": "2.5.41",
  "version_name": "2.5 Build 41 · Branding & White-Label Platform",
  "description": "AI engineering layer for Lovable projects with local Branding and White-Label profiles, custom product identity, logo, accents, community and support links; Productivity Suite command palette, searchable history, autosaving project notes, shortcuts, favorites and recent actions; premium Project Brain, Rules, Impact Map and Explain Project tools; premium Chat and Engineering UX; premium Workspace browser; premium rail launcher; local sanitized Error Intelligence; document-start frame protection; premium license activation UX; native pt-BR voice feedback; project monitor; capability registry; fail-closed hardening; approval transactions; Auto Repair; Decrypter Chat; Project Recovery Doctor; reconciled Lovable/GitHub/Supabase state; server-authoritative trust; Knowledge and Model Gateway.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": ["storage", "tabs", "downloads", "unlimitedStorage", "alarms"],
  "host_permissions": [
    "https://lovable.dev/*",
    "https://*.lovable.dev/*",
    "https://api.github.com/*",
    "https://codeload.github.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.supabase.com/*",
    "https://*.supabase.co/*"
  ],
  "background": { "service_worker": "background/service-worker-entry.js", "type": "module" },
  "browser_specific_settings": {
    "gecko": {
      "id": "lovable-decrypter@rhashiki.dev",
      "strict_min_version": "121.0",
      "data_collection_permissions": { "required": ["authenticationInfo", "websiteContent"] }
    }
  },
  "action": { "default_title": "Lovable Decrypter v2.5 Build 41 · Branding & White-Label Platform" },
  "content_scripts": [
    {
      "matches": ["https://lovable.dev/*", "https://*.lovable.dev/*"],
      "js": ["content/early-boot-sentinel.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["https://lovable.dev/*", "https://*.lovable.dev/*"],
      "js": [
        "content/ui-shell-bootstrap.js",
        "content/content.js",
        "content/ui-mount-guardian.js",
        "content/error-intelligence-core.js",
        "ui/ui.js",
        "ui/error-intelligence-center.js",
        "ui/license-gate-premium.js",
        "ui/voice-feedback.js",
        "content/credential-ui-guard.js",
        "content/lovable-project-runtime.js",
        "content/lovable-workspace-deep-read.js",
        "content/project-state-graph-core.js",
        "content/unified-project-state-graph.js",
        "content/project-recovery-doctor-core.js",
        "content/project-recovery-doctor.js",
        "content/lovable-project-creator.js",
        "content/cloud-migrator-runtime-v2.js",
        "content/project-intelligence.js",
        "content/skill-router.js",
        "content/project-rules-cache.js",
        "ui/skills-engine.js",
        "ui/control-center.js",
        "content/checkpoint-ui.js",
        "content/batch-mode.js",
        "content/queue-project-context.js",
        "content/queue-atomic-skip.js",
        "content/queue-executor.js",
        "ui/project-context.js",
        "ui/premium-workspace.js",
        "ui/github-autosync.js",
        "ui/project-migration.js",
        "ui/project-creator.js",
        "ui/supabase-project-manager.js",
        "ui/cloud-migrator-complete.js",
        "content/lovable-sync-verifier.js",
        "content/composer-bridge-v3.js",
        "content/composer-guardian.js",
        "content/decrypter-chat-core.js",
        "content/decrypter-chat.js",
        "content/approval-auto-repair.js",
        "content/hardening-core.js",
        "content/capability-registry.js",
        "content/hardening-sentinel.js",
        "content/build11-reconciliation.js",
        "ui/unified-launcher.js",
        "content/commercial-runtime.js",
        "content/build12-reconciliation.js",
        "content/live-operations.js",
        "content/activity-cloud-sync.js",
        "ui/activity-center.js",
        "content/build13-reconciliation.js",
        "ui/update-recovery.js",
        "ui/launcher-rail-v3.js",
        "ui/premium-engineering-ux.js",
        "ui/premium-project-tools.js",
        "ui/productivity-suite.js",
        "ui/branding-white-label.js",
        "content/build14-reconciliation.js",
        "content/build15-reconciliation.js",
        "content/build16-reconciliation.js",
        "content/build17-reconciliation.js",
        "content/build18-reconciliation.js"
      ],
      "css": [
        "ui/matrix.css",
        "ui/error-intelligence-center.css",
        "ui/license-gate-premium.css",
        "ui/control-center.css",
        "ui/composer-bridge.css",
        "ui/composer-guardian.css",
        "ui/editor-direct-v3.css",
        "ui/github-app.css",
        "ui/project-context.css",
        "ui/premium-workspace.css",
        "ui/project-migration.css",
        "ui/project-creator.css",
        "ui/supabase-project-manager.css",
        "ui/cloud-migrator-core.css",
        "ui/skills-engine.css",
        "ui/unified-launcher.css",
        "ui/unified-launcher-status.css",
        "ui/activity-center.css",
        "ui/update-recovery.css",
        "ui/recovery-doctor.css",
        "ui/design-system-v3.css",
        "ui/premium-engineering-ux.css",
        "ui/premium-project-tools.css",
        "ui/productivity-suite.css",
        "ui/branding-white-label.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    { "resources": ["assets/fab.png", "assets/icon128.png"], "matches": ["https://lovable.dev/*", "https://*.lovable.dev/*"] }
  ]
}

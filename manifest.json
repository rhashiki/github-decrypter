{
  "manifest_version": 3,
  "name": "Lovable Decrypter",
  "version": "2.2.0",
  "description": "AI engineering layer for Lovable projects with signed licenses, Supabase commerce, cloud skills, command queue, encrypted vault and Gemini Free/User-Paid modes.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://lovable.dev/*",
    "https://*.lovable.dev/*",
    "https://api.github.com/*",
    "https://codeload.github.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.supabase.com/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "scripts": [
      "background/service-worker-entry.js"
    ],
    "service_worker": "background/service-worker-entry.js",
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lovable-decrypter@rhashiki.dev",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "websiteContent"
        ]
      }
    }
  },
  "action": {
    "default_title": "Lovable Decrypter v2.2.0"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lovable.dev/*",
        "https://*.lovable.dev/*"
      ],
      "js": [
        "content/credential-ui-guard.js",
        "content/content.js",
        "ui/ui.js",
        "ui/control-center.js",
        "content/checkpoint-ui.js"
      ],
      "css": [
        "ui/matrix.css",
        "ui/control-center.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://lovable.dev/*",
        "https://*.lovable.dev/*"
      ],
      "js": [
        "content/project-intelligence.js",
        "content/project-rules-cache.js",
        "content/skill-router.js",
        "content/composer-pro.js",
        "content/cloud-runtime.js",
        "content/preview-progress-overlay.js",
        "content/composer-bridge.js",
        "content/batch-mode.js",
        "content/automatic-suggestions.js",
        "content/cloud-ui.js",
        "content/queue-project-context.js",
        "content/queue-executor.js",
        "content/monitor.js",
        "content/dom-guardian.js"
      ],
      "css": [
        "ui/composer-bridge.css",
        "ui/composer-pro.css",
        "ui/preview-progress-overlay.css",
        "ui/cloud-ui.css",
        "ui/cloud-runtime.css",
        "ui/monitor.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/fab.png",
        "assets/icon128.png"
      ],
      "matches": [
        "https://lovable.dev/*",
        "https://*.lovable.dev/*"
      ]
    }
  ]
}

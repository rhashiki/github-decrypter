# Runtime container
VLLM_IMAGE=vllm/vllm-openai:latest
MODEL_ID=Qwen/Qwen3-Coder-30B-A3B-Instruct
SERVED_MODEL_NAME=decrypter-local
RUNTIME_TOKEN=replace-with-a-long-random-server-secret
BIND_HOST=127.0.0.1
PORT=8000
MAX_MODEL_LEN=65536
GPU_MEMORY_UTILIZATION=0.92
HF_CACHE_DIR=./.cache/huggingface
HF_TOKEN=

# Supabase Edge Function secrets (configure in the deployment environment, never in the extension)
# DECRYPTER_LOCAL_URL=https://private-inference.example.com
# DECRYPTER_LOCAL_TOKEN=<same private runtime token or gateway credential>
# DECRYPTER_LOCAL_MODEL=decrypter-local
# DECRYPTER_LOCAL_MODEL_LABEL=Qwen/Qwen3-Coder-30B-A3B-Instruct

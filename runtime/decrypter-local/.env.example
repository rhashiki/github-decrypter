# Build 60 default runtime: Ollama + Qwen3-Coder 30B A3B
OLLAMA_IMAGE=ollama/ollama:0.32.14
OLLAMA_MODEL=qwen3-coder:30b
OLLAMA_DATA_DIR=./.cache/ollama
OLLAMA_KEEP_ALIVE=15m
OLLAMA_TIMEOUT_SECONDS=210
SERVED_MODEL_NAME=decrypter-local
DECRYPTER_MODEL_LABEL=Qwen3-Coder 30B A3B · Ollama
RUNTIME_TOKEN=replace-with-a-long-random-server-secret
BIND_HOST=127.0.0.1
PORT=8000
MAX_BODY_BYTES=8000000

# Worker control plane. The public endpoint must be an authenticated HTTPS
# address routing to the local gateway on PORT. Secrets stay server-side only.
DECRYPTER_CONTROL_URL=https://kkzxxnfxgrouhkzyszxs.supabase.co/functions/v1/ld-local-control
DECRYPTER_WORKER_SECRET=replace-with-a-long-random-worker-control-secret
DECRYPTER_WORKER_ENDPOINT=https://gpu-worker-01.example.com
DECRYPTER_WORKER_INSTANCE_KEY=gpu-worker-01
DECRYPTER_WORKER_ZONE=
DECRYPTER_WORKER_MAX_INFLIGHT=1
DECRYPTER_HEARTBEAT_SECONDS=15
DECRYPTER_POOL_CODE=decrypter-local-primary
DECRYPTER_RUNTIME_KIND=ollama
DECRYPTER_RUNTIME_MODEL=qwen3-coder:30b
DECRYPTER_RUNTIME_URL=http://decrypter-local:8000

# Optional vLLM profile (compose.vllm.yaml)
VLLM_IMAGE=vllm/vllm-openai:latest
MODEL_ID=Qwen/Qwen3-Coder-30B-A3B-Instruct
MAX_MODEL_LEN=65536
GPU_MEMORY_UTILIZATION=0.92
HF_CACHE_DIR=./.cache/huggingface
HF_TOKEN=

# Supabase backend-only secrets/settings. Never put these in the extension.
# DECRYPTER_LOCAL_TOKEN=<same private RUNTIME_TOKEN injected into workers>
# DECRYPTER_LOCAL_MODEL=decrypter-local
# DECRYPTER_LOCAL_MODEL_LABEL=Qwen3-Coder 30B A3B · Ollama
# DECRYPTER_WORKER_SECRET=<worker registration/heartbeat secret>
# Optional provider-neutral autoscaler actuator:
# DECRYPTER_GPU_SCALER_URL=https://your-scaler.example.com/reconcile
# DECRYPTER_GPU_SCALER_TOKEN=<private actuator bearer token>
# Optional legacy single-runtime fallback only:
# DECRYPTER_LOCAL_URL=https://single-private-inference.example.com

WORKSPACE_DIR=./workspace
DECRYPTER_WORKSPACE_ID=project-id-here
DECRYPTER_TOOL_WORKER_TOKEN=replace-with-a-long-random-server-secret
BIND_HOST=127.0.0.1
PORT=8787
DECRYPTER_TOOL_MAX_READ_BYTES=300000
DECRYPTER_TOOL_MAX_GREP_FILES=1200
DECRYPTER_TOOL_MAX_GREP_MATCHES=120
DECRYPTER_TOOL_MAX_LIST_FILES=1500
DECRYPTER_LSP_TIMEOUT_MS=10000

# Supabase backend-only configuration. Never expose these in the extension.
# DECRYPTER_TOOL_WORKER_URL=https://tool-worker.example.com
# DECRYPTER_TOOL_WORKER_TOKEN=<same private token used by the worker>

{
  "schema": "ld-decrypter-coder-config/1",
  "name": "Decrypter-Coder-30B-A3B-v1",
  "base_model": "Qwen/Qwen3-Coder-30B-A3B-Instruct",
  "base_license": "Apache-2.0",
  "method": "qlora",
  "served_model": "decrypter-local",
  "training": {
    "max_seq_length": 8192,
    "num_train_epochs": 2,
    "learning_rate": 0.0001,
    "warmup_ratio": 0.03,
    "lr_scheduler_type": "cosine",
    "per_device_train_batch_size": 1,
    "per_device_eval_batch_size": 1,
    "gradient_accumulation_steps": 8,
    "gradient_checkpointing": true,
    "logging_steps": 10,
    "eval_steps": 100,
    "save_steps": 100,
    "save_total_limit": 2,
    "seed": 20420
  },
  "quantization": {
    "load_in_4bit": true,
    "bnb_4bit_quant_type": "nf4",
    "bnb_4bit_use_double_quant": true,
    "bnb_4bit_compute_dtype": "bfloat16"
  },
  "lora": {
    "r": 32,
    "lora_alpha": 64,
    "lora_dropout": 0.05,
    "bias": "none",
    "target_modules": "all-linear",
    "task_type": "CAUSAL_LM"
  },
  "optimizer": "paged_adamw_8bit",
  "dataset": {
    "schema": "ld-decrypter-coder-dataset/1",
    "total_examples": 2400,
    "train_examples": 2160,
    "validation_examples": 240,
    "synthetic_only": true,
    "private_customer_code_training": false,
    "decrypterbench_holdout": true
  },
  "promotion": {
    "benchmark": "DecrypterBench",
    "require_same_suite_hash": true,
    "min_average_score_delta": 1.0,
    "min_pass_rate_delta": 0,
    "max_category_regression": 1.0,
    "require_security_non_regression": true,
    "require_scope_non_regression": true,
    "require_high_risk_failure_non_regression": true
  }
}
